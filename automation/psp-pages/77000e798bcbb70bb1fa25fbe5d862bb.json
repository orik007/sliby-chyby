{"schemaVersion":"psp-page-cache-v1","id":"77000e798bcbb70bb1fa25fbe5d862bb","url":"https://www.psp.cz/sqw/historie.sqw?o=10&t=131","contentSha256":"c93f1c554c90c4701d8585c3df600ed0bf7e27927077c39c50f2b1cef035236e","readOn":"2026-10-20","checkedOn":"2026-10-20","content":"<div id=\"main-content\"><div class=\"page-title\"><!-- s_host = ??, ??, sec_line=,0,-->    <!-- vazba 5586--><!-- SAX 12000--><!-- SAX 13000--><!-- SAX 19000--><!-- SAX 15000--><!-- llpxy 211458 --><h1>Sněmovní tisk <A HREF=\"tisky.sqw?O=10&T=131\">131</A><br>Novela z. o volbách do zastupitelstev obcí</h1></div><p class=\"info\"><a href=\"/sqw/hp.sqw?k=331\" class=\"button light info no-print\">Vysvětlení legislativního procesu</a></p><div class=\"clear\"></div><!-- LLLP 210948 2118 100 --><!-- LLLP 210973 101 200 --><!-- LLLP 211096 102 200 --><!-- LLLP 211143 2058 300 --><!-- LLLP 211305 170 1010 --><!-- LLLP 211306 171 1010 --><!-- LLLP 211321 132 10000 --><!-- LLLP 211321 0 12000 --><!-- LLLP 211321 0 13000 --><!-- LLLP 211321 0 14000 --><!-- LLLP 211321 0 15000 --><!-- LLLP 211321 0 19000 --><!-- LLLP 211385 133 15000 --><!-- LLLP 211395 143 21000 --><!-- LLLP 211444 2077 21000 --><!-- LLLP 211458 151 23000 --><!-- LLLP 211458 0 23600 --><!-- LLLP 211458 0 24000 --><!-- lx_mm = 240-->            <!-- Legislative process schema -->            <div class=\"legislative-process no-print\">                <!-- Predkladatel -->            \t<span class=\"submitter narrow\">Předkladatel</span>                <!--/ Predkladatel -->                <span class=\"arrow\">&rarr;</span>                <!-- Predsedkyne snemovny -->                <span class=\"legislative-block\">                \tPS                    <span class=\"marks\"><abbr class=\"mark person completed\" title=\"Předseda sněmovny\"><span>PS</span></abbr>                    </span>                </span>                <!--/ Predsedkyne snemovny --> <span class=\"arrow\">&rarr;</span><!-- Vláda --><span class=\"legislative-block\">Vláda<span class=\"marks\"> <abbr class=\"mark completed\" title=\"Vláda\">VL</abbr></span></span><!--/ Vládat -->                <span class=\"arrow\">&rarr;</span>                <!-- Poslanecka snemovna -->                <span class=\"legislative-block chamber-of-deputies\">                \tPoslanecká sněmovna                    <span class=\"marks\"> <abbr class=\"mark completed\" title=\"Organizační výbor\">O</abbr> <abbr class=\"mark completed\" title=\"1. čtení\">1</abbr>                    </span>                </span>                <!--/ Poslanecka snemovna --> <span class=\"arrow\">&rarr;</span><!-- Senat --><span class=\"legislative-block senate\">Senát<span class=\"marks\"> <abbr class=\"mark person completed\" title=\"Předseda Senátu\"><span>PS</span></abbr> <abbr class=\"mark completed\" title=\"Organizační výbor\">O</abbr> <abbr class=\"mark completed\" title=\"Výbory\">V</abbr> <abbr class=\"mark completed\" title=\"Senát\">S</abbr></span></span><!--/ Senat --> <span class=\"arrow\">&rarr;</span><!-- Prezident --><span class=\"legislative-block president\">Prezident<span class=\"marks\"> <abbr class=\"mark completed\" title=\"Prezident\">P</abbr></span></span><!--/ Prezident --> <span class=\"arrow\">&rarr;</span><!-- Zakon --><span class=\"paragraph approved\">Zákon</span><!--/ Zakon -->            </div>            <!--/ Legislative process schema -->                                  <!-- EndR 210948, 120 (600) --><div class=\"section\" id=\"st-sx-a\"><h2 class=\"section-title\">Senát</h2><div class=\"section-content\"><!-- Document Log --><ul class=\"document-log\"><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark person completed\"><span>PS</span></span></span><p> <b>předložil</b>  Senátu návrh zákona 19.&nbsp;1.&nbsp;2026. Návrh zákona <b>rozeslán</b>  dne 19.&nbsp;1.&nbsp;2026 senátorům jako tisk <b>196/0</b>.<br><!-- EndR 210948, 130 (600) --><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">O</span></span><p>Organizační výbor  dne 21.&nbsp;1.&nbsp;2026 <b>stanovil</b> garančním výborem Ústavně-právní výbor (&nbsp;) a <b>přikázal</b> tisk k projednání: Stálá komise Senátu pro Ústavu České republiky a parlamentní procedury (&nbsp;).<!-- EndR 210948, 140 (600) --></p></li><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">V</span></span><ul><li><b>Ústavně-právní výbor</b> projednal návrh  dne 4.&nbsp;2.&nbsp;2026 a přijal usnesení č. 107, které bylo rozdáno jako tisk <b><a href=\"http://www.senat.cz/xqw/webdav/pssenat/original/118683/99622\">196/1</a></b> (<i>pozměňovací návrhy</i>).</li></ul><!-- EndR 210948, 150 (600) --></li><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">S</span></span><p><!-- akc=8--><!-- vj=Senát návrh <b>přikázal k projednání</b>, uiv=53-->Návrh <b>projednán</b>  dne 21.&nbsp;1.&nbsp;2026 na 19. schůzi Senátu.<br>Senát návrh <b>přikázal k projednání</b> (usnesení č. <a href=\"http://www.senat.cz/xqw/xervlet/pssenat/htmlhled?action=doc&value=118624\">354</a>).<br><!-- akc=8--><!-- vj=Senát <b>schvaluje</b> senátní návrh zákona, uiv=60-->Návrh <b>projednán</b>  dne 4.&nbsp;3.&nbsp;2026 na 21. schůzi Senátu.<br>Senát <b>schvaluje</b> senátní návrh zákona (usnesení č. <a href=\"http://www.senat.cz/xqw/xervlet/pssenat/htmlhled?action=doc&value=119069\">377</a>).</p></li></ul><!--/ Document Log --></div></div><div class=\"section\" id=\"st-xx-a\"><h2 class=\"section-title\">Předkladatel</h2><div class=\"section-content simple\">Senát <B>předložil</B> sněmovně návrh zákona 9.&nbsp;3.&nbsp;2026.<BR>Zástupce navrhovatele: Canov M. a další.<br></p></div></div><!-- EndR 210948, 1 (240) --><div class=\"section\" id=\"st-ps-a\"><h2 class=\"section-title\">Poslanecká sněmovna</h2><div class=\"section-content\"><!-- Document Log --><ul class=\"document-log\"><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark person completed\"><span>PS</span></span></span><p>Návrh zákona rozeslán poslancům jako tisk <B><A HREF=\"/sqw/text/tiskt.sqw?O=10&CT=131&CT1=0\">131/0</A></b> dne 11.&nbsp;3.&nbsp;2026.<br><br>Navrhovatel <b>navrhl</b> sněmovně projednávání návrhu zákona tak, aby sněmovna s ním mohla vyslovit souhlas již v prvém čtení (<a href=\"../docs/laws/1995/90.html#90\">§&nbsp;90 odstavec&nbsp;2 zákona č.&nbsp;90/1995 Sb</a>, o&nbsp;jednacím řádu Poslanecké sněmovny, ve&nbsp;znění pozdějších předpisů).Parlamentní institut <b>vypracoval stanovisko</b> ke kompatibilitě tisku s právem EU <a href=\"https://www.psp.cz/sqw/text/text2.sqw?idd=269148\">0131</a>.<br>        </p></li></ul><!--/ Document Log --></div></div><div class=\"section\" id=\"st-gv-a\"><h2 class=\"section-title\">Vláda</h2><div class=\"section-content\"><!-- Document Log --><ul class=\"document-log\"><!-- EndR 210973, 2 (240) --><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">VL</span></span><p> Návrh <b>zaslán</b> vládě k&nbsp;vyjádření stanoviska 11.&nbsp;3.&nbsp;2026.         Vláda zaslala stanovisko 31.&nbsp;3.&nbsp;2026. <B>Stanovisko vlády</B> rozesláno poslancům 1.&nbsp;4.&nbsp;2026 jako tisk <B><a href=\"/sqw/text/tiskt.sqw?o=10&ct=131&ct1=1\">131/1</a></B> (<i>souhlas</i>).<br>Stanovisko zaevidováno v systému <b>eKLEP</b> pod čj. OVA <b><a href=\"https://odok.cz/portal/veklep/material/KORNDS5FLZJK/\">212/26</a></b>, PID KORNDS5FLZJK.<br>            </p></li></ul><!--/ Document Log --></div></div><div class=\"section\" id=\"st-ps-a\"><h2 class=\"section-title\">Poslanecká sněmovna</h2><div class=\"section-content\"><!-- Document Log --><ul class=\"document-log\"><!-- EndR 211143, 3 (240) --><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">O</span></span><p>    <B>Organizační výbor</B> projednání návrhu zákona <B>doporučil</B> 2.&nbsp;4.&nbsp;2026 (usnesení č.&nbsp;<a href=\"/sqw/text/tiskt.sqw?o=10&v=ORGV&ct=46\">46</a>). Určil zpravodaje: <b><a href=\"https://www.psp.cz/sqw/detail.sqw?id=6999&o=10\">Katerina&nbsp;Demetrashvili</a></b> a navrhl <b><a href=\"hp.sqw?k=4000&o=10\">Ústavně-právní výbor</a></b> jako garanční.    </p></li><!-- EndR 211305, 10 (240) --><li class=\"document-log-item reading-1\"><span class=\"marks\"><span class=\"mark completed\">1</span></span><p><strong class=\"highlight\">1. Čtení</strong><!-- EndR 211305, 15 (240) -->Návrh byl projednán v obecné rozpravě <a href=\"../eknih/2025ps/stenprot/014schuz/14-6.html#q650\">23.&nbsp;4.&nbsp;2026</a> na 14. schůzi. Sněmovna <B>souhlasila</B> s projednáváním tak, aby mohla s návrhem zákona vyslovit souhlas již v prvém čtení (usnesení č.&nbsp;<a href=\"/sqw/text/tiskt.sqw?o=10&v=US&ct=162\">162</a>).    <!-- EndR 211306, 15 (240) --><!--- 1-->Návrh byl projednán v obecné rozpravě 23.&nbsp;4.&nbsp;2026 na 14. schůzi.<br>Návrh zákona byl <b>přijat</b> (hlasování č. <a href=\"hlasy.sqw?G=87270\">166</a>, usnesení č.&nbsp;<a href=\"/sqw/text/tiskt.sqw?o=10&v=US&ct=162\">162</a>).        </li></ul><!--/ Document Log --></div></div><p class=\"status warning\">Text návrhu zákona <b><a href=\"/sqw/text/tiskt.sqw?o=10&ct=131&ct1=0&v=PZ&pn=&pt=\">schváleného</a></b> Poslaneckou sněmovnou.</p></li><div class=\"section\" id=\"st-se-a\"><h2 class=\"section-title\">Senát</h2><div class=\"section-content\"><!-- Document Log --><ul class=\"document-log\"><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark person completed\"><span>PS</span></span></span><p>Poslanecká sněmovna <b>postoupila</b>  dne 28.&nbsp;4.&nbsp;2026 návrh zákona Senátu jako tisk <b><a href=\"https://www.senat.cz/xqw/xervlet/pssenat/historie?cid=pssenat_historie.pHistorieTisku.list&forEach.action=detail&forEach.value=s5586\">231</a></b>, dokument <b>231/0</b>.<br><!-- EndR 211321, 130 (240) --></p></li><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">O</span></span><p>Organizační výbor  dne 28.&nbsp;4.&nbsp;2026 <b>stanovil</b> garančním výborem Ústavně-právní výbor (&nbsp;).<!-- EndR 211321, 140 (240) --></p></li><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">V</span></span><ul><li><b>Ústavně-právní výbor</b> projednal návrh  dne 29.&nbsp;4.&nbsp;2026 a přijal usnesení č. 125, které bylo rozdáno jako tisk <b><a href=\"http://www.senat.cz/xqw/webdav/pssenat/original/119678/100513\">231/1</a></b> (<i>schvaluje</i>).</li></ul><!-- EndR 211321, 150 (240) --></li><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">S</span></span><p><!-- akc=8--><!-- vj=Senát návrh <b>schválil</b>, uiv=66-->Návrh <b>projednán</b>  dne 6.&nbsp;5.&nbsp;2026 na 24. schůzi Senátu.<br>Senát návrh <b>schválil</b> (usnesení č. <a href=\"http://www.senat.cz/xqw/xervlet/pssenat/htmlhled?action=doc&value=119812\">429</a>).                <BR><!--- 1--></p></li></ul><!--/ Document Log --></div></div><div class=\"section\" id=\"st-pr-a\"><h2 class=\"section-title\">Prezident republiky</h2><div class=\"section-content\"><!-- Document Log --><ul class=\"document-log\"><!-- EndR 211395, 210 (240) --><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">P</span></span><p>Zákon <B>doručen</B> prezidentovi k podepsání 12.&nbsp;5.&nbsp;2026.        <BR>Prezident zákon <B>podepsal</B> 19.&nbsp;5.&nbsp;2026.        <BR>Rozhodnutí <b>doručeno</b> do Sněmovny 20.&nbsp;5.&nbsp;2026.        </p></li></ul><!--/ Document Log --></div></div><div class=\"section\" id=\"st-gv-b\"><h2 class=\"section-title\">Sbírka zákonů</h2><div class=\"section-content\"><!-- Document Log --><ul class=\"document-log\"><!-- EndR 211458, 230 (240) --><li class=\"document-log-item\"><span class=\"marks\"><span class=\"mark completed\">Sb</span></span><p>Schválený zákon <b>odeslán</b> k publikaci ve Sbírce zákonů 22.&nbsp;5.&nbsp;2026.    </p></li></ul><!--/ Document Log --></div></div><p class=\"status okx\">Zákon <B>vyhlášen</B> 26.&nbsp;5.&nbsp;2026 ve  Sbírce zákonů v částce 70 pod číslem <a href=\"sbirka.sqw?O=10&T=131\">70/2026</a> Sb.</p>            <sqw_flush> <p><b><a href=\"historie.sqw?o=10&t=131&snzp=1\">Navržené změny předpisů</a></b> (1)<br><br><div class=\"clear\"></div></div><!--/ Main content --><div class=\"clear\"></div></div></div><!--/ Body --><hr>\n\n<!-- Menu -->\n"}

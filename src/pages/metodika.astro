---
import BaseLayout from "../layouts/BaseLayout.astro";
import { statusDetails } from "../lib/data";

const scaleGroups = [
  { title: "Výsledek", statuses: ["fulfilled", "acting-against"] as const },
  { title: "Směr", statuses: ["moving-towards", "moving-against"] as const },
  { title: "Zatím bez ověřeného podstatného posunu", statuses: ["no-progress"] as const },
];
const statusDescriptions = {
  fulfilled: "Strana rozhodla ve prospěch celého slibu: její poslanci ve Sněmovně většinou hlasovali pro opatření, které slib celý splňuje, nebo tak rozhodla vláda, ve které strana je.",
  "moving-towards": "Strana udělala skutečný krok správným směrem: její poslanci nebo vláda, ve které je, předložili návrh v souladu se slibem, strana hlasovala pro opatření, které splňuje část slibu, nebo proti opatření, které slibu odporuje. Sem patří i slib něco nezměnit, dokud slíbený stav trvá.",
  "no-progress": "Zatím nemáme ověřený důkaz podstatného kroku ve prospěch ani proti tomuto slibu. Neznamená to, že strana nic nedělá nebo že žádný další záznam neexistuje.",
  "moving-against": "Strana udělala krok opačným směrem: předložila návrh proti slibu, rozhodla o opatření, které odporuje části slibu, nebo nepodpořila rozhodující hlasování o opatření, které by slib splnilo.",
  "acting-against": "Strana rozhodla proti celému slibu: její poslanci většinou hlasovali pro opatření, které mu odporuje, nebo proti opatření, které by ho splnilo, případně tak rozhodla vláda, ve které strana je.",
};
const exampleRows = [
  { status: "fulfilled", count: 5 },
  { status: "acting-against", count: 2 },
  { status: "moving-towards", count: 3 },
  { status: "moving-against", count: 1 },
  { status: "no-progress", count: 2 },
] as const;
const examplePoints = exampleRows.reduce((sum, row) => sum + row.count * statusDetails[row.status].score, 0);
const examplePromiseCount = exampleRows.reduce((sum, row) => sum + row.count, 0);
const exampleMaximum = examplePromiseCount * 2;
const exampleIndex = Math.round((examplePoints / exampleMaximum) * 100);
const formatScore = (score: number) => `${score > 0 ? "+" : score < 0 ? "−" : ""}${Math.abs(score)} ${Math.abs(score) === 1 ? "bod" : "body"}`;
const formatNumber = (value: number) => `${value > 0 ? "+" : value < 0 ? "−" : ""}${Math.abs(value)}`;
---
<BaseLayout title="Metodika SLAVA Indexu · Sliboměr" description="Jak Sliboměr rozlišuje splněný slib, ověřený posun a jednání proti slibu.">
  <article class="method-page"><a class="back-link" href="/">← Na přehled</a><header><p class="eyebrow">TRANSPARENTNÍ METODIKA</p><h1>SLAVA Index<br />bez dojmologie.</h1><p class="intro">Nehodnotíme, zda je politika dobrá. Hodnotíme pouze, zda jednání strany odpovídá jejím vlastním předvolebním slibům.</p></header>
  <section class="method-scale" aria-labelledby="scale-title">
    <h2 id="scale-title">Pět srozumitelných stavů</h2>
    <p class="scale-intro">Každému slibu přiřadíme jeden z těchto pěti stavů podle úředních záznamů o jednání strany.</p>
    <div class="scale-columns">
      {scaleGroups.map((group) => <article class="scale-group"><p class="scale-group-title">{group.title}</p><div class="scale-pair">{group.statuses.map((status) => { const detail = statusDetails[status]; return <div class={`scale-item status-${detail.className}`}><span>{detail.symbol}</span><div><strong>{detail.label}</strong><small>{formatScore(detail.score)}</small><p>{statusDescriptions[status]}</p></div></div>; })}</div></article>)}
    </div>
    <p class="methodology-note"><strong>Pokud strana prokazatelně jedná proti svým slibům, dostává záporné body.</strong> Zatím bez ověřeného podstatného posunu a jednání proti slibu tak nejsou totéž.</p>
    <p class="methodology-note"><strong>Návrh znamená ±1, rozhodnutí o celém slibu ±2.</strong> Slib zůstává na nule, dokud nemáme ověřené jednání strany jedním směrem. Samotný uplynulý čas skóre nemění. Hlasování hodnotíme podle toho, jak strana hlasovala, bez ohledu na další osud zákona.</p>
    <p class="methodology-note"><strong>Hodnotíme jen úřední záznamy:</strong> hlasování ve Sněmovně a návrhy, které jí předložili poslanci nebo vláda (zákony, státní rozpočet a mezinárodní smlouvy). Weby stran, tiskové zprávy ani média důkazem nejsou.</p>
    <p class="methodology-note" id="novely"><strong>U novel zatím nevidíme dosavadní znění zákona.</strong> Novelu posuzujeme podle jejího textu. Když něco ruší nebo nahrazuje, její text často říká jen „§ 10a se zrušuje“, ale ne, co v tomto ustanovení stálo. Proto nemusíme vždy poznat, zda novela pravidla zpřísňuje, nebo uvolňuje. Například zrušení stropu strukturálního schodku 1,25 % HDP pro rok 2027 v zákoně o pravidlech rozpočtové odpovědnosti se ze samotného textu novely vyčíst nedá. Nových zákonů a státního rozpočtu se to netýká, jejich celý text posuzujeme přímo.</p>
    <p class="methodology-note" id="vyroky"><strong>Výroky nehodnotíme.</strong> Program obsahuje i výroky, které nelze splnit ani porušit konkrétním zákonem, hlasováním nebo návrhem vlády, například obecné hodnoty a cíle. Na stránce strany je lze zobrazit, ale nemají skóre a nepočítají se do SLAVA Indexu.</p>
  </section>
  <section class="calculation-section" aria-labelledby="calculation-title">
    <div class="calculation-copy"><p class="eyebrow">VÝPOČET</p><h2 id="calculation-title">−100 až +100 bodů</h2><p>Sečteme aktuální hodnocení všech slibů a vydělíme je jejich maximálním možným bodovým ziskem.</p><code>součet bodů ÷ (2 × počet slibů) × 100</code></div>
    <article class="example-card"><p class="eyebrow">MODELOVÝ PŘÍKLAD</p><h3>Strana má {examplePromiseCount} slibů</h3><div class="example-rows">{exampleRows.map((row) => { const detail = statusDetails[row.status]; const points = row.count * detail.score; return <div class="example-row"><span><b>{row.count}×</b> {detail.label.toLowerCase()}</span><span>{row.count} × {formatNumber(detail.score)}</span><strong>{formatNumber(points)}</strong></div>; })}</div><div class="example-total"><div><span>Součet bodů</span><strong>{formatNumber(examplePoints)}</strong></div><div><span>Maximum</span><strong>{exampleMaximum}</strong></div></div><div class="example-result"><span>SLAVA Index</span><strong>{formatNumber(exampleIndex)}</strong><small>{formatNumber(examplePoints)} ÷ {exampleMaximum} × 100 = {((examplePoints / exampleMaximum) * 100).toFixed(1).replace(".", ",")}</small></div></article>
  </section>
  <aside id="published-data" class="publication-note"><strong>Průběžný výpočet:</strong> SLAVA Index se počítá ze všech dosud zveřejněných slibů dané strany. S každým novým ověřeným hodnocením se automaticky přepočítá. Pokud strana zatím nemá žádný zveřejněný slib, index se nezobrazuje.</aside></article>
</BaseLayout>

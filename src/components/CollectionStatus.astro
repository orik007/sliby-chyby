---
import { systemStatus } from "../lib/data";

// The last successful check whose assessments are published: the
// assessment-revision pull request sets it (docs/evidence-pipeline.md, From
// proposal to public score).
const date = new Intl.DateTimeFormat("cs-CZ", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Prague",
}).format(new Date(systemStatus.lastSuccessfulCollectionAt));
---
<p class="collection-status">
  Poslední kontrola slibů proběhla:{" "}
  <strong><time datetime={systemStatus.lastSuccessfulCollectionAt}>{date}</time></strong>
</p>

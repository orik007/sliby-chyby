---
import Header from "../components/Header.astro";
import CollectionStatus from "../components/CollectionStatus.astro";
import "../styles/global.css";
interface Props { title?: string; description?: string; socialImage?: string | null; }
const { title = "Sliboměr", description = "Přehled předvolebních slibů politických stran a jejich skutečných kroků.", socialImage = "/og-slibomer.png" } = Astro.props;
const canonicalPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url).href;
const socialImageUrl = socialImage ? new URL(socialImage, Astro.site ?? Astro.url).href : null;
---
<!doctype html><html lang="cs"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="robots" content="index,follow" /><link rel="canonical" href={canonicalUrl} /><link rel="icon" href="/favicon.ico" sizes="32x32" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="cs_CZ" /><meta property="og:site_name" content="Sliboměr" /><meta property="og:url" content={canonicalUrl} />{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}<meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}<title>{title}</title></head><body><Header /><main><slot /></main><footer class="site-footer"><div class="site-footer-copy"><span>Každý zveřejněný slib má ověřený původní zdroj a aktuální stav od <strong class="footer-score-negative">−2</strong> do <strong class="footer-score-positive">+2</strong>.</span><span>Novely zákonů zatím posuzujeme jen podle jejich textu, bez dosavadního znění zákona, a proto nemusíme vždy poznat, zda pravidla zpřísňují, nebo uvolňují. <a href="/metodika#novely">Více v metodice</a></span><CollectionStatus /></div><a href="/metodika">Metodika SLAVA Indexu</a></footer></body></html>

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sliby-chyby-release-control",
  "main": "./automation/release-control/src/index.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "OWNER_LOGIN": "orik007",
    "COPILOT_REVIEWER_LOGIN": "copilot-pull-request-reviewer[bot]"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PULL_REQUEST_STATE",
        "class_name": "PullRequestState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PullRequestState"]
    }
  ]
}

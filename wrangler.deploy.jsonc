{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sliby-chyby",
  "compatibility_date": "2026-09-03",
  "main": "./dist/server/entry.mjs",
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}

    "word-extractor": "^1.0.4",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "pdfjs-dist": "^5.7.284",
    "typescript": "latest",
    "wrangler": "^4.125.0"
  }

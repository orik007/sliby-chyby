{
  "name": "sliby-chyby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node --test tests/*.test.mjs && astro check && astro build && node scripts/prepare-sites-build.mjs",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "assess:batch": "node scripts/run-assessment-batch.mjs --packages automation/runs/pipeline/github-actions/matcher/enriched-evidence-packages --enrichment-run automation/runs/pipeline/github-actions/matcher/enriched-evidence-packages/enrichment-run.json",
    "collect:evidence": "node scripts/run-collectors.mjs --since-days 7",
    "audit:coverage": "node scripts/run-coverage-audit.mjs",
    "reviews:refresh": "node scripts/refresh-review-markdown.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@openai/sites-vite-plugin": "latest",
    "astro": "latest",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest",
    "wrangler": "^4.125.0"
  }
}

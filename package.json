{
  "name": "sliby-chyby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node --test tests/*.test.mjs && astro check && astro build && node scripts/prepare-sites-build.mjs",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "assess:batch": "node scripts/run-assessment-batch.mjs --packages automation/evidence-packages",

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StatementBadge from "../../../components/StatementBadge.astro";
import StatusBadge from "../../../components/StatusBadge.astro";
import EvidenceTrail from "../../../components/EvidenceTrail.astro";
import { formatDate, trailStepCount } from "../../../lib/evidence-trail";
import { getAssessmentHistory, getCurrentPartySummaries, getItemSource, getPublicAssessmentExplanation, getSource, statementExplanation, statusDetails } from "../../../lib/data";

export const prerender = true;

export function getStaticPaths() {
  return getCurrentPartySummaries().flatMap((summary) => [
    ...summary.promises.map(({ promise, assessment, policyCategory }) => ({ params: { party: summary.party.slug, slug: promise.slug }, props: { summary, item: promise, assessment, policyCategory } })),
    ...summary.statements.map(({ statement, policyCategory }) => ({ params: { party: summary.party.slug, slug: statement.slug }, props: { summary, item: statement, assessment: null, policyCategory } })),
  ]);
}
const { summary, item, assessment, policyCategory } = Astro.props;
const { party, period } = summary;
const itemSource = getItemSource(item);
const sourceLabel = `${itemSource.source.title} · ${itemSource.source.publisher} · ${itemSource.locatorLabel}`;
const evidence = assessment ? assessment.evidenceSourceIds.map(getSource) : [];
const history = assessment ? getAssessmentHistory(item.id) : [];
const status = assessment ? statusDetails[assessment.status] : null;
const assessmentExplanation = assessment ? getPublicAssessmentExplanation(assessment.explanationShort) : null;
const evidenceHeading = assessment?.baselinePromiseSourceId ? "ZDROJ VÝCHOZÍHO STAVU" : assessment?.evidenceTrail ? "DŮKAZY K TOMUTO STAVU" : "POUŽITÉ DŮKAZY";
---
<BaseLayout title={`${item.title} · ${party.shortName} · Sliboměr`} description={assessmentExplanation ?? statementExplanation}>
  <article class="promise-detail"><a class="back-link" href={`/strany/${party.slug}`}>← Zpět na {party.shortName}</a><header class="promise-detail-header"><p class="eyebrow">{party.shortName} · {policyCategory.labelCz} · {period.label}</p><h1>{item.title}</h1>{assessment ? <StatusBadge status={assessment.status} /> : <StatementBadge />}</header><div class:list={["detail-grid", { "detail-grid-single": !assessment }]}><div class="detail-main">
    <section class="detail-block"><span class="step-number">01</span><p class="eyebrow">{assessment ? "CO STRANA SLÍBILA" : "CO STRANA ŘEKLA"}</p><blockquote>„{item.originalText}“</blockquote><p class="source-caption">{itemSource.url ? <a href={itemSource.url} target="_blank" rel="noreferrer">{sourceLabel} ↗</a> : sourceLabel}</p></section>
    {assessment && status ? <>
    <section class="detail-block"><span class="step-number">02</span><p class="eyebrow">PROČ MÁ TENTO STAV</p><h2>{status.label}</h2><p class="detail-copy">{assessmentExplanation}</p></section>
    <section class="detail-block"><span class="step-number">03</span><p class="eyebrow">{evidenceHeading}</p>{assessment.evidenceTrail && <EvidenceTrail trail={assessment.evidenceTrail} />}{evidence.length > 0 && <ul class="source-list">{evidence.map((source) => <li><span class:list={["source-type", { secondary: !source.primary }]}>{source.primary ? "Primární" : "Kontext"}</span><div>{source.url ? <a href={source.url} target="_blank" rel="noreferrer"><strong>{source.title} ↗</strong></a> : <strong>{source.title}</strong>}<small>{source.publisher} · {formatDate(source.publishedAt)}</small></div></li>)}</ul>}</section>
    </> : <section class="detail-block"><span class="step-number">02</span><p class="eyebrow">PROČ SE NEHODNOTÍ</p><h2>Výrok bez hodnocení</h2><p class="detail-copy">{statementExplanation} <a href="/metodika#vyroky">Jak hodnotíme sliby →</a></p></section>}
  </div>{assessment && <aside class="history-panel"><p class="eyebrow">HISTORIE HODNOCENÍ</p><ol>{history.map((revision) => { const detail = statusDetails[revision.status]; return <li><span class={`history-symbol status-${detail.className}`}>{detail.symbol}</span><div><strong>{detail.label}</strong><time datetime={revision.publishedAt}>{formatDate(revision.publishedAt)}</time><p>{getPublicAssessmentExplanation(revision.explanationShort)}</p>{revision.evidenceTrail && <details class="history-evidence"><summary>Důkazy ({trailStepCount(revision.evidenceTrail)})</summary><EvidenceTrail trail={revision.evidenceTrail} compact /></details>}</div></li>; })}</ol></aside>}</div></article>
</BaseLayout>
